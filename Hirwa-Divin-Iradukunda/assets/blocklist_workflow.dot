// Editable source for blocklist_workflow.png
// Render: dot -Tpng -Gdpi=150 blocklist_workflow.dot -o blocklist_workflow.png
digraph blocklist_workflow {
  rankdir=LR;
  fontname="Helvetica"; node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=10];
  newrank=true;

  attacker [label="Attacker\n203.0.113.7", shape=box, style="rounded,filled", fillcolor="#f8d7da"];

  subgraph cluster_a {
    label="Campus A"; style="rounded"; color="#555555";
    sshA [label="SSH login server", shape=box];
    f2bA [label="Local detector\n(fail2ban)", shape=box];
    nodeA [label="Blocklist node A", shape=box, style="filled", fillcolor="#d1e7dd"];
  }
  subgraph cluster_b {
    label="Campus B"; style="rounded"; color="#555555";
    nodeB [label="Blocklist node B", shape=box, style="filled", fillcolor="#d1e7dd"];
    sshB [label="SSH login server", shape=box];
  }
  subgraph cluster_c {
    label="Campus C"; style="rounded"; color="#555555";
    nodeC [label="Blocklist node C", shape=box, style="filled", fillcolor="#d1e7dd"];
    sshC [label="SSH login server", shape=box];
  }

  attacker -> sshA [label="1. failed logins"];
  sshA -> f2bA [label="2. auth log"];
  f2bA -> nodeA [label="3. local ban"];
  nodeA -> nodeB [label="4. signed report"];
  nodeA -> nodeC [label="4. signed report"];
  nodeB -> sshB [label="5. ban once k of n\ncampuses report"];
  nodeC -> sshC [label="5. ban once k of n\ncampuses report"];
  attacker -> sshB [label="6. later attempt blocked", style=dashed, color="#b02a37", fontcolor="#b02a37"];
}
